# Réglages communs : un délai pour recevoir une requête (contre les connexions qui traînent exprès),
# et pas d'adresse IP des visiteurs dans les messages d'erreur de Caddy non plus.
{
	servers {
		timeouts {
			read_header 10s
			read_body 15s
		}
	}
	log default {
		format filter {
			wrap console
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>headers>X-Forwarded-For delete
			}
		}
	}
}

# Caddy obtient le certificat HTTPS tout seul, pourvu que DOMAINE pointe sur la droplet
# et que les ports 80 et 443 soient ouverts (caddyserver.com/docs/automatic-https).
DOMAINE {
	encode gzip
	# Au plus 16 Ko par requête : une question et un court historique.
	request_body {
		max_size 16KB
	}
	header {
		X-Frame-Options DENY
		Permissions-Policy "camera=(), geolocation=()"
		-Server
	}
	# Caddy reçoit toute la requête avant de la passer au service : une requête envoyée goutte à goutte
	# occupe Caddy, pas l'une des 32 places du service.
	# (Caddy 2.6, celui d'Ubuntu 24.04 : « buffer_requests » ; à partir de Caddy 2.7 : « request_buffers 16KB ».)
	reverse_proxy 127.0.0.1:8080 {
		buffer_requests
	}
	log {
		# Pas d'adresse IP des visiteurs dans les journaux de Caddy.
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>headers>X-Forwarded-For delete
			}
		}
	}
}
